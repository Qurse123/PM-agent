query GetIssue($id: String!) {
  issue(id: $id) {
    id
    identifier
    title
    description
    state { name }
    assignee { displayName }
    team { id name }
    createdAt
    updatedAt
    comments {
      nodes {
        body
        user { displayName }
        createdAt
      }
    }
  }
}
