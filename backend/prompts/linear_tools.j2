[
  {
    "type": "function",
    "function": {
      "name": "search_linear_issues",
      "description": "Search Linear issues by keyword. Returns a list of matching issues with id, identifier, title, state, assignee, team (including teamId), and description.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Keyword search string"},
          "first": {"type": "integer", "description": "Max results to return", "default": 20},
          "after": {"type": "string", "description": "Cursor for pagination (optional)"}
        },
        "required": ["query"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_linear_issue",
      "description": "Fetch full details of a single Linear issue by its ID.",
      "parameters": {
        "type": "object",
        "properties": {
          "issue_id": {"type": "string", "description": "The Linear issue ID"}
        },
        "required": ["issue_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_proposal",
      "description": "Record a proposed change to a Linear issue for human review. The 'after' field MUST contain the actual new field values you are proposing — it is NOT optional. Example for an update: after={\"description\": \"Updated text with new details\", \"priority\": 1}. Example for a create: after={\"title\": \"New issue title\", \"description\": \"Details\", \"teamId\": \"abc123\"}. You MUST always populate 'after' with real values before calling this tool.",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {"type": "string", "enum": ["linear"], "description": "Always 'linear'"},
          "operation": {"type": "string", "enum": ["create", "update"], "description": "'update' to modify an existing issue, 'create' to propose a brand new issue"},
          "before": {
            "type": ["object", "null"],
            "description": "Current state of the issue being updated (copy from search results). Use null for create operations."
          },
          "after": {
            "type": "object",
            "description": "REQUIRED. The actual proposed field values. For 'update': only include fields being changed, e.g. {\"description\": \"new description text\"}. For 'create': must include title, description, and teamId.",
            "minProperties": 1
          },
          "citations": {
            "type": "array",
            "description": "Transcript evidence. Must have at least one entry with segment_ids, quote, and rationale.",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "segment_ids": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "segment_ids from the VALID SEGMENT IDs list"
                },
                "quote": {"type": "string", "description": "Exact verbatim text from the transcript"},
                "rationale": {"type": "string", "description": "Why this quote supports the proposed change"}
              },
              "required": ["segment_ids", "quote", "rationale"]
            }
          }
        },
        "required": ["target", "operation", "after", "citations"]
      }
    }
  }
]
